# /etc/nginx/sites-available/canvas-mcp  (then: certbot --nginx -d canvas-mcp.example.com)
server {
    listen 443 ssl;
    http2 on;
    server_name canvas-mcp.example.com;

    # ssl_certificate / ssl_certificate_key managed by certbot

    # The secret is part of the URL path; keep it out of access logs.
    access_log off;

    location /mcp {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;          # streamable HTTP / SSE responses
        proxy_read_timeout 120s;
    }

    location = /healthz { proxy_pass http://127.0.0.1:8787; }
    location / { return 404; }
}
