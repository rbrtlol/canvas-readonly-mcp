# ---- Required ----
# Your Canvas address, e.g. https://canvas.instructure.com or https://canvas.yourschool.edu
CANVAS_BASE_URL=
# Canvas → Account → Settings → "+ New access token"
CANVAS_TOKEN=
# HTTP mode only: random secret that gates the endpoint (openssl rand -hex 32)
MCP_SECRET=

# ---- Optional (defaults shown) ----
# Other hostnames of the same Canvas, comma-separated (e.g. yourschool.instructure.com)
# CANVAS_HOST_ALIASES=
# Time zone for displayed times; default: the one in your Canvas profile
# DISPLAY_TZ=
# Turn off the raw canvas_api_get tool
# ENABLE_RAW_GET=true

# Snapshots / change log. By default the courses on your Canvas dashboard are included.
# SNAPSHOT_ENABLED=true
# dashboard (favorited courses, or Canvas's pick) | active (every active enrollment)
# SNAPSHOT_SCOPE=dashboard
# Only these course ids (comma-separated); "id:label:role" overrides the label/role
# SNAPSHOT_COURSES=
# SNAPSHOT_EXCLUDE=
# Daily run time (in DISPLAY_TZ) or "off"
# SNAPSHOT_AT=04:30
# Refresh at startup / on demand when older than this
# SNAPSHOT_MAX_AGE_H=20
# Which files to extract text from for change detection: linked | all | none
# SNAPSHOT_EXTRACT=linked
# EVENT_RETENTION_DAYS=120

# Files
# MAX_FILE_MB=50
# DOWNLOAD_TIMEOUT_S=60
# EXTRACT_TIMEOUT_S=60
# EXTRACT_MAX_PAGES=500
# CACHE_MAX_MB=500
