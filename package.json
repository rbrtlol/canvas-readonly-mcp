{
  "name": "canvas-readonly-mcp",
  "version": "2.0.0",
  "description": "Read-only MCP server for Canvas LMS: courses, deadlines, pages, file contents (PDF/PPTX/DOCX) and a daily change log, for Claude and other MCP clients",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "canvas",
    "canvas-lms",
    "instructure",
    "claude",
    "lms",
    "education"
  ],
  "license": "MIT",
  "author": "Robert Rosenquist",
  "homepage": "https://github.com/rbrtlol/canvas-readonly-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbrtlol/canvas-readonly-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/rbrtlol/canvas-readonly-mcp/issues"
  },
  "type": "module",
  "bin": {
    "canvas-readonly-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "rm -rf build-test && tsc -p tsconfig.test.json && node --disable-warning=ExperimentalWarning --test --test-reporter=spec 'build-test/test/**/*.test.js'",
    "start:http": "node dist/cli.js --http",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "diff": "9.0.0",
    "express": "5.3.0",
    "fflate": "0.8.3",
    "unpdf": "1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
